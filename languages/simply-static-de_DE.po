msgstr "Empfohlen für Shared Hosting und Server hinter einer Firewall."

#: src/admin/src/settings/pages/DeploymentSettings.jsx:1053
msgid "Enter your SFTP host."
msgstr "Gib deinen SFTP-Host ein."

#: src/admin/src/settings/pages/DeploymentSettings.jsx:1067
msgid "Enter your SFTP port."
msgstr "Gib deinen SFTP-Port ein."

#: src/admin/src/settings/pages/DeploymentSettings.jsx:1077
