#: src/admin/src/settings/pages/Optimize.jsx:161
msgid "Don't minify or aggregate files on your static website."
msgstr "Dateien auf deiner statischen Website nicht minifizieren oder bündeln."

#: src/admin/src/settings/pages/Optimize.jsx:175
msgid "Minification is handled by Studio"
msgstr "Studio übernimmt die Minifizierung"

#: src/admin/src/settings/pages/Optimize.jsx:178
msgid "Studio prepares optimized build assets automatically, so the low-level CSS and JavaScript minification options are not needed for Studio environments."
msgstr "Studio bereitet optimierte Build-Dateien automatisch vor. Die detaillierten Optionen zur CSS- und JavaScript-Minifizierung werden für Studio-Umgebungen daher nicht benötigt."

#: src/admin/src/settings/pages/Optimize.jsx:181
msgid "Minify"
msgstr "Minifizieren"

#: src/admin/src/settings/pages/Optimize.jsx:184
msgid "Minify CSS"
msgstr "CSS minifizieren"

#: src/admin/src/settings/pages/Optimize.jsx:188
msgid "Minify CSS files."
msgstr "CSS minifizieren."

#: src/admin/src/settings/pages/Optimize.jsx:189
msgid "Don't minify CSS files."
msgstr "CSS nicht minifizieren."

#: src/admin/src/settings/pages/Optimize.jsx:200
msgid "Exclude Stylesheet URLs"
msgstr "Stylesheet-URLs ausschließen"

#: src/admin/src/settings/pages/Optimize.jsx:202
#: src/admin/src/settings/pages/Optimize.jsx:230
msgid "Exclude URLs from minification (one per line)."
msgstr "URLs von der Minimierung ausschließen (eine pro Zeile)."

#: src/admin/src/settings/pages/Optimize.jsx:212
msgid "Minify JavaScript"
msgstr "JavaScript minifizieren"

#: src/admin/src/settings/pages/Optimize.jsx:216
msgid "Minify JavaScript files."
msgstr "JavaScript minifizieren."

#: src/admin/src/settings/pages/Optimize.jsx:217
msgid "Don't minify JavaScript files."
msgstr "JavaScript nicht minifizieren."

#: src/admin/src/settings/pages/Optimize.jsx:228
msgid "Exclude JavaScript URLs"
msgstr "JavaScript-URLs ausschließen"

#: src/admin/src/settings/pages/Optimize.jsx:240
msgid "Protect jQuery Globals"
msgstr "Globale jQuery-Variablen schützen"

#: src/admin/src/settings/pages/Optimize.jsx:242
msgid "Prevent mangling of jQuery, $, and wp global variables during JS minification."
msgstr "Verhindert, dass die globalen Variablen jQuery, $ und wp bei der JavaScript-Minifizierung umbenannt werden."

#: src/admin/src/settings/pages/Optimize.jsx:251
msgid "Aggregate"
msgstr "Bündeln"

#: src/admin/src/settings/pages/Optimize.jsx:254
msgid "Aggregate CSS"
msgstr "CSS bündeln"

#: src/admin/src/settings/pages/Optimize.jsx:256
msgid "Combine multiple CSS files into fewer bundles grouped by media attribute and deferral status."
msgstr "Mehrere CSS-Dateien anhand von Medienattribut und Zurückstellungsstatus zu weniger Paketen bündeln."

#: src/admin/src/settings/pages/Optimize.jsx:266
msgid "Aggregate JavaScript"
msgstr "JavaScript bündeln"

#: src/admin/src/settings/pages/Optimize.jsx:268
msgid "Combine multiple JS files into fewer bundles grouped by loading attributes (defer, async, delayed) and position (head/body)."
msgstr "Mehrere JavaScript-Dateien anhand ihrer Ladeattribute (defer, async, verzögert) und Position (head/body) zu weniger Paketen bündeln."

#: src/admin/src/settings/pages/Optimize.jsx:278
msgid "Exclude Patterns"
msgstr "Ausschlussmuster"

#: src/admin/src/settings/pages/Optimize.jsx:280
msgid "Glob patterns for files to exclude from aggregation (one per line). Use this for scripts that break when concatenated, such as Google Maps init scripts, payment gateway SDKs, or scripts using document.write()."
msgstr "Glob-Muster für Dateien, die von der Bündelung ausgeschlossen werden sollen (eines pro Zeile). Verwende dies für Skripte, die beim Zusammenfügen nicht mehr funktionieren, etwa Initialisierungsskripte von Google Maps, SDKs von Zahlungsanbietern oder Skripte mit document.write()."

#: src/admin/src/settings/pages/Optimize.jsx:298
msgid "Defer & Delay"
msgstr "Zurückstellen und verzögern"

#: src/admin/src/settings/pages/Optimize.jsx:309
msgid "Eliminate render-blocking CSS and JavaScript resources to improve Lighthouse scores and page load speed."
msgstr "Beseitigt render-blockierende CSS- und JavaScript-Ressourcen, um Lighthouse-Werte und Ladezeiten zu verbessern."

#: src/admin/src/settings/pages/Optimize.jsx:311
msgid "Enable Defer & Delay?"
msgstr "Zurückstellen und Verzögern aktivieren?"

#: src/admin/src/settings/pages/Optimize.jsx:315
msgid "Optimize render-blocking resources during static export."
msgstr "Render-blockierende Ressourcen während des statischen Exports optimieren."

#: src/admin/src/settings/pages/Optimize.jsx:316
msgid "Don't optimize render-blocking resources."
msgstr "Render-blockierende Ressourcen nicht optimieren."

#: src/admin/src/settings/pages/Optimize.jsx:329
msgid "Defer Non-Critical CSS"
msgstr "Nicht kritisches CSS zurückstellen"

#: src/admin/src/settings/pages/Optimize.jsx:331
msgid "Convert non-critical stylesheets to load asynchronously using the media=\"print\" pattern."
msgstr "Nicht kritische Stylesheets mit dem Muster media=\"print\" in asynchron geladene Stylesheets umwandeln."

#: src/admin/src/settings/pages/Optimize.jsx:342
msgid "Critical CSS Patterns"
msgstr "Muster für kritisches CSS"

#: src/admin/src/settings/pages/Optimize.jsx:344
msgid "Glob patterns for stylesheets that must remain render-blocking (one per line). Default: */style.css, */styles.css, */global.css, */theme*.css, */wp-block-*.css"
msgstr "Glob-Muster für Stylesheets, die render-blockierend bleiben müssen (eines pro Zeile). Standard: */style.css, */styles.css, */global.css, */theme*.css, */wp-block-*.css"

#: src/admin/src/settings/pages/Optimize.jsx:355
msgid "Defer Synchronous Scripts"
msgstr "Synchrone Skripte zurückstellen"

#: src/admin/src/settings/pages/Optimize.jsx:357
msgid "Add the defer attribute to render-blocking scripts. Preserves execution order (safe for jQuery dependencies)."
msgstr "Fügt render-blockierenden Skripten das Attribut defer hinzu. Die Ausführungsreihenfolge bleibt erhalten (sicher für jQuery-Abhängigkeiten)."

#: src/admin/src/settings/pages/Optimize.jsx:368
msgid "Defer Exclude Patterns"
msgstr "Ausschlussmuster für das Zurückstellen"

#: src/admin/src/settings/pages/Optimize.jsx:370
msgid "Additional glob patterns for scripts to exclude from deferral (one per line). Built-in patterns already exclude WordPress core scripts: jQuery, wp-i18n, wp-hooks, wp-url, wp-api-fetch, and wp-api."
msgstr "Zusätzliche Glob-Muster für Skripte, die nicht zurückgestellt werden sollen (eines pro Zeile). Integrierte Muster schließen WordPress-Core-Skripte bereits aus: jQuery, wp-i18n, wp-hooks, wp-url, wp-api-fetch und wp-api."

#: src/admin/src/settings/pages/Optimize.jsx:381
msgid "Optimize Google Fonts"
msgstr "Google Fonts optimieren"

#: src/admin/src/settings/pages/Optimize.jsx:383
msgid "Preload Google Fonts stylesheets, inject the Google Fonts preconnect hint, and add display=swap for faster font loading."
msgstr "Stylesheets von Google Fonts vorladen, den Preconnect-Hinweis für Google Fonts einfügen und display=swap hinzufügen, damit Schriften schneller geladen werden."

#: src/admin/src/settings/pages/Optimize.jsx:393
msgid "Add Preconnect Hints"
msgstr "Preconnect-Hinweise hinzufügen"

#: src/admin/src/settings/pages/Optimize.jsx:395
msgid "Add preconnect resource hints for high-value third-party font, icon, script, and image origins found in exported pages."
msgstr "Preconnect-Ressourcenhinweise für wichtige externe Quellen von Schriften, Icons, Skripten und Bildern hinzufügen, die auf exportierten Seiten gefunden wurden."

#: src/admin/src/settings/pages/Optimize.jsx:405
msgid "Delay Non-Critical JavaScript"
msgstr "Nicht kritisches JavaScript verzögern"

#: src/admin/src/settings/pages/Optimize.jsx:407
msgid "Delay third-party scripts (analytics, tag managers, tracking pixels) until user interaction to reduce Total Blocking Time. Scripts load on first click, scroll, or keypress."
msgstr "Skripte von Drittanbietern (Analysen, Tag-Manager, Tracking-Pixel) bis zur ersten Benutzerinteraktion verzögern, um die Total Blocking Time zu reduzieren. Die Skripte werden beim ersten Klick, Scrollen oder Tastendruck geladen."

#: src/admin/src/settings/pages/Optimize.jsx:418
msgid "Additional Delay Patterns"
msgstr "Zusätzliche Verzögerungsmuster"

#: src/admin/src/settings/pages/Optimize.jsx:420
msgid "Additional glob patterns for scripts to delay (one per line). Built-in patterns already cover Google (Tag Manager, Analytics, Ads, reCAPTCHA), HubSpot, Facebook/Meta Pixel, Hotjar, Clarity, Bing UET, Cloudflare (Insights, Turnstile), CleanTalk, Matomo/Piwik, Plausible, Twitter/X, LinkedIn, Pinterest, Tawk.to, Crisp, LiveChat, Intercom, Drift, Tidio, Segment, Amplitude, Mixpanel, Optimizely, Mouseflow, Lucky Orange, Crazy Egg, FullStory, LogRocket, and Sentry."
msgstr "Zusätzliche Glob-Muster für zu verzögernde Skripte (eines pro Zeile). Integrierte Muster decken bereits Google (Tag Manager, Analytics, Ads, reCAPTCHA), HubSpot, Facebook/Meta Pixel, Hotjar, Clarity, Bing UET, Cloudflare (Insights, Turnstile), CleanTalk, Matomo/Piwik, Plausible, Twitter/X, LinkedIn, Pinterest, Tawk.to, Crisp, LiveChat, Intercom, Drift, Tidio, Segment, Amplitude, Mixpanel, Optimizely, Mouseflow, Lucky Orange, Crazy Egg, FullStory, LogRocket und Sentry ab."

#: src/admin/src/settings/pages/Optimize.jsx:429
msgid "Delay Exclude Patterns"
msgstr "Ausschlussmuster für Verzögerungen"

#: src/admin/src/settings/pages/Optimize.jsx:431
msgid "Glob patterns for scripts that must run without Simply Static's interaction delay (one per line). Patterns match script URLs, element IDs, and inline script content. You can also add data-ssp-no-delay to a script tag. Exclusions do not override your consent manager."
msgstr "Glob-Muster für Skripte, die ohne die Interaktionsverzögerung von Simply Static ausgeführt werden müssen (eines pro Zeile). Die Muster werden mit Skript-URLs, Element-IDs und Inline-Skriptinhalten abgeglichen. Du kannst einem script-Tag auch data-ssp-no-delay hinzufügen. Ausschlüsse setzen deinen Consent-Manager nicht außer Kraft."

#: src/admin/src/settings/pages/Optimize.jsx:440
msgid "Delay Fallback Timeout (seconds)"
msgstr "Fallback-Zeitüberschreitung für Verzögerungen (Sekunden)"

#: src/admin/src/settings/pages/Optimize.jsx:446
msgid "Release delayed scripts after this many seconds if there is no user interaction. Use 0 to release them immediately."
msgstr "Verzögerte Skripte nach dieser Anzahl von Sekunden freigeben, wenn keine Benutzerinteraktion erfolgt. Verwende 0, um sie sofort freizugeben."

#: src/admin/src/settings/pages/Optimize.jsx:463
msgid "Image Optimization"
msgstr "Bild-Optimierung"

#: src/admin/src/settings/pages/Optimize.jsx:476
msgid "Image optimization is handled by Studio"
msgstr "Studio übernimmt die Bildoptimierung"

#: src/admin/src/settings/pages/Optimize.jsx:479
msgid "Studio optimizes the static build pipeline for its hosting environment, so you do not need to connect ShortPixel for Studio deployments."
msgstr "Studio optimiert die statische Build-Pipeline für seine Hosting-Umgebung. Du musst ShortPixel daher nicht für Studio-Deployments verbinden."

#: src/admin/src/settings/pages/Optimize.jsx:483
msgid "Optimize Images with ShortPixel?"
msgstr "Bilder mit ShortPixel optimieren?"

#: src/admin/src/settings/pages/Optimize.jsx:487
msgid "Optimize images with the ShortPixel API."
msgstr "Bilder mit der ShortPixel-API optimieren."

#: src/admin/src/settings/pages/Optimize.jsx:488
msgid "Don't optimize images with the ShortPixel API."
msgstr "Bilder nicht mit der ShortPixel-API optimieren."

#: src/admin/src/settings/pages/Optimize.jsx:499
msgid "ShortPixel API Key"
msgstr "ShortPixel API Key"

#: src/admin/src/settings/pages/Optimize.jsx:510
msgid "Convert to WebP"
msgstr "In WebP konvertieren"

#: src/admin/src/settings/pages/Optimize.jsx:514
msgid "Convert images to WebP format."
msgstr "Bilder in das WebP-Format konvertieren."

#: src/admin/src/settings/pages/Optimize.jsx:515
msgid "Don't convert images to WebP format."
msgstr "Bilder nicht in das WebP-Format konvertieren."

#: src/admin/src/settings/pages/Optimize.jsx:524
msgid "Backup the original images?"
msgstr "Original-Bilder als Backup speichern?"

#: src/admin/src/settings/pages/Optimize.jsx:528
msgid "Back original images."
msgstr "Original-Bilder als Backup speichern."

#: src/admin/src/settings/pages/Optimize.jsx:529
msgid "Don't backup original images."
msgstr "Originalbilder nicht sichern."

#: src/admin/src/settings/pages/Optimize.jsx:539
msgid "It will preserve every image which might increase your disk space usage."
msgstr "Alle Originalbilder bleiben erhalten, wodurch der Speicherplatzbedarf steigen kann."

#: src/admin/src/settings/pages/Optimize.jsx:544
msgid "Restore Original Images"
msgstr "Original-Bilder wiederherstellen"

#: src/admin/src/settings/pages/Optimize.jsx:547
msgid "Restoring..."
msgstr "Wiederherstellen.."

#: src/admin/src/settings/pages/Optimize.jsx:559
msgid "Critical CSS"
msgstr "Kritisches CSS"

#: src/admin/src/settings/pages/Optimize.jsx:564
msgid "Requires Static Studio"
msgstr "Erfordert Static Studio"

#: src/admin/src/settings/pages/Optimize.jsx:570
msgid "Generate critical above-the-fold CSS to eliminate render-blocking stylesheets and improve page load speed. Critical CSS is generated for the homepage and injected into every page."
msgstr "Erzeugt kritisches CSS für den sichtbaren Seitenbereich, um render-blockierende Stylesheets zu vermeiden und die Ladezeit zu verbessern. Das kritische CSS wird für die Startseite erstellt und in jede Seite eingefügt."

#: src/admin/src/settings/pages/Optimize.jsx:572
msgid "Enable Critical CSS Generation?"
msgstr "Erzeugung von kritischem CSS aktivieren?"

#: src/admin/src/settings/pages/Optimize.jsx:576
msgid "Critical CSS will be generated during static export."
msgstr "Kritisches CSS wird während des statischen Exports erzeugt."

#: src/admin/src/settings/pages/Optimize.jsx:577
msgid "Don't generate critical CSS."
msgstr "Kein kritisches CSS erzeugen."

#: src/admin/src/settings/pages/Optimize.jsx:591
msgid "By default, critical CSS is generated from the homepage only. Add additional page URLs here (one per line) if those pages have significantly different styles."
msgstr "Standardmäßig wird kritisches CSS nur anhand der Startseite erzeugt. Füge hier weitere Seiten-URLs hinzu (eine pro Zeile), wenn diese Seiten deutlich andere Stile verwenden."

#: src/admin/src/settings/pages/Optimize.jsx:600
msgid "Custom CSS"
msgstr "Benutzerdefiniertes CSS"

#: src/admin/src/settings/pages/Optimize.jsx:602
msgid "Add custom CSS that will be appended to the generated critical CSS. Use this to fix minor visual glitches."
msgstr "Füge eigenes CSS hinzu, das an das erzeugte kritische CSS angehängt wird. Damit kannst du kleinere Darstellungsfehler beheben."

#: src/admin/src/settings/pages/Optimize.jsx:618
msgid "Versioning"
msgstr "Versionierung"

#: src/admin/src/settings/pages/Optimize.jsx:630
msgid "Version CSS?"
msgstr "CSS versionieren?"

#: src/admin/src/settings/pages/Optimize.jsx:634
msgid "Appends a version query string to CSS files."
msgstr "Hängt eine Versions-Abfragezeichenfolge an CSS-Dateien an."

#: src/admin/src/settings/pages/Optimize.jsx:635
msgid "Don't append a version query string to CSS files."
msgstr "Keine Versions-Abfragezeichenfolge an CSS-Dateien anhängen."

#: src/admin/src/settings/pages/Optimize.jsx:645
msgid "Version JavaScript?"
msgstr "JavaScript versionieren?"

#: src/admin/src/settings/pages/Optimize.jsx:649
msgid "Appends a version query string to JavaScript files."
msgstr "Hängt eine Versions-Abfragezeichenfolge an JavaScript-Dateien an."

#: src/admin/src/settings/pages/Optimize.jsx:650
msgid "Don't append a version query string to JavaScript files."
msgstr "Keine Versions-Abfragezeichenfolge an JavaScript-Dateien anhängen."

#: src/admin/src/settings/pages/SearchSettings.jsx:66
msgid "Use search?"
msgstr "Suche benutzen?"

#: src/admin/src/settings/pages/SearchSettings.jsx:70
msgid "Use search on your static website."
msgstr "Nutze Suche auf deiner statischen Website."

#: src/admin/src/settings/pages/SearchSettings.jsx:71
msgid "Don't use search on your static website."
msgstr "Nutze keine Suche auf deiner statischen Website."

#: src/admin/src/settings/pages/SearchSettings.jsx:81
msgid "Search Type"
msgstr "Suche-Typ"

#: src/admin/src/settings/pages/SearchSettings.jsx:83
msgid "Decide which search type you want to use. Fuse runs locally based on a file, and Algolia is an external API service."
msgstr "Wähle den gewünschten Suchtyp. Fuse arbeitet lokal mit einer Datei, Algolia ist ein externer API-Dienst."

#: src/admin/src/settings/pages/SearchSettings.jsx:101
msgid "Use Search Results Page"
msgstr "Nutze die Suchergebnisseite"

#: src/admin/src/settings/pages/SearchSettings.jsx:103
msgid "Simply Static will create a static search results page and the export will include a special __qs directory."
msgstr "Simply Static erstellt eine statische Suchergebnisseite und der Export enthält ein spezielles __qs-Verzeichnis."

#: src/admin/src/settings/pages/SearchSettings.jsx:112
msgid "Use Submit Button"
msgstr "Absende-Schaltfläche verwenden"

#: src/admin/src/settings/pages/SearchSettings.jsx:114
msgid "Show or hide the submit button in the search UI."
msgstr "Ein- oder Ausblenden der Schaltfläche \"Senden\" in der Benutzeroberfläche der Suche."

#: src/admin/src/settings/pages/SearchSettings.jsx:125
msgid "Submit button text"
msgstr "„Senden“-Schaltfläche Text"

#: src/admin/src/settings/pages/SearchSettings.jsx:130
msgid "Customize the submit button text or HTML (e.g., add an icon)."
msgstr "Passe Text oder HTML der Absende-Schaltfläche an, um zum Beispiel ein Icon hinzuzufügen."

#: src/admin/src/settings/pages/SearchSettings.jsx:141
msgid "Show excerpt in suggestions/results"
msgstr "Auszug in Vorschlägen/Ergebnissen anzeigen"

#: src/admin/src/settings/pages/SearchSettings.jsx:143
msgid "Enable to display the excerpt below each search suggestion and result item."
msgstr "Aktivieren, um den Textauszug unter jedem Suchvorschlag und Suchergebnis anzuzeigen."

#: src/admin/src/settings/pages/SearchSettings.jsx:153
msgid "Input placeholder"
msgstr "Platzhalter"

#: src/admin/src/settings/pages/SearchSettings.jsx:157
msgid "Search.."
msgstr "Suche.."

#: src/admin/src/settings/pages/SearchSettings.jsx:158
msgid "Customize the placeholder text for the search input."
msgstr "Passe den Platzhaltertext des Suchfelds an."

#: src/admin/src/settings/pages/SearchSettings.jsx:171
msgid "How to select data with meta tags"
msgstr "Wie man Daten aus Metatags selektiert"

#: src/admin/src/settings/pages/SearchSettings.jsx:172
msgid "Targeting for excerpt in the meta description tag."
msgstr "Ziel für das Excerpt im Meta-Description-Tag."

#: src/admin/src/settings/pages/SearchSettings.jsx:176
#: src/admin/src/settings/pages/SearchSettings.jsx:184
msgid "Adding such meta in the excerpt field would be:"
msgstr "Ein Beispiel dafür würde wie folgt aussehen:"

#: src/admin/src/settings/pages/SearchSettings.jsx:180
msgid "Targeting for title in the property meta tag."
msgstr "Ziel für den Title im Meta-Description-Tag."

#: src/admin/src/settings/pages/SearchSettings.jsx:188
msgid "If the second item (after | ) is not <code>content</code>, we'll use it as value of that attribute (<code>property=\"og:title\"</code> in this example) and use <code>content</code> for value."
msgstr "Wenn das zweite Element (nach | ) nicht <code>content</code> ist, nutzen wir den Wert dieses Attributs (<code>property=\"og:title\"</code>in diesem Beispiel <code>content</code> als Wert."

#: src/admin/src/settings/pages/SearchSettings.jsx:189
msgid "Caution: Use meta tags that exist everywhere for title."
msgstr "Warnung: Nutze Meta-Tags die überall für den Titel existieren."

#: src/admin/src/settings/pages/SearchSettings.jsx:198
msgid "Indexing"
msgstr "Indexierung"

#: src/admin/src/settings/pages/SearchSettings.jsx:210
msgid "CSS selector for title"
msgstr "CSS-Selektor für den Titel"

#: src/admin/src/settings/pages/SearchSettings.jsx:217
msgid "Add the CSS selector which contains the title of the page/post"
msgstr "Trage den CSS-Selector ein der den Titel der Seite enthält."

#: src/admin/src/settings/pages/SearchSettings.jsx:219
#: src/admin/src/settings/pages/SearchSettings.jsx:239
#: src/admin/src/settings/pages/SearchSettings.jsx:260
msgid "Or meta tags. Click for more information."
msgstr "Oder Meta-Tags. Klicke für mehr Informationen."

#: src/admin/src/settings/pages/SearchSettings.jsx:230
msgid "CSS selector for content"
msgstr "CSS-Selektor für den Inhalt"

#: src/admin/src/settings/pages/SearchSettings.jsx:237
msgid "Add the CSS selector which contains the content of the page/post."
msgstr "Trage den CSS-Selector ein der den Inhalt der Seite enthält."

#: src/admin/src/settings/pages/SearchSettings.jsx:251
msgid "CSS selector for excerpt"
msgstr "CSS-Selektor für den Textauszug"

#: src/admin/src/settings/pages/SearchSettings.jsx:258
msgid "Add the CSS selector which contains the excerpt of the page/post."
msgstr "Trage den CSS-Selector ein der die Kurzbeschreibung der Seite enthält."

#: src/admin/src/settings/pages/SearchSettings.jsx:272
msgid "Exclude URLs"
msgstr "URLs ausschließen"

#: src/admin/src/settings/pages/SearchSettings.jsx:275
msgid "Exclude URLs from indexing (one per line). You can use full URLs, parts of a URL, or plain words (such as stop words)."
msgstr "URLs von der Indexierung ausschließen (eine pro Zeile). Du kannst vollständige URLs, Teile einer URL oder einzelne Wörter wie Stoppwörter verwenden."

#: src/admin/src/settings/pages/SearchSettings.jsx:292
msgid "Fuse.js"
msgstr "Fuse.js"

#: src/admin/src/settings/pages/SearchSettings.jsx:304
#: src/admin/src/settings/pages/SearchSettings.jsx:488
msgid "CSS selector"
msgstr "CSS-Selektor"

#: src/admin/src/settings/pages/SearchSettings.jsx:308
#: src/admin/src/settings/pages/SearchSettings.jsx:492
msgid "Add the CSS selector for the <form> element that contains your search input field."
msgstr "Gib den CSS-Selektor des <form>-Elements ein, das dein Suchfeld enthält."

#: src/admin/src/settings/pages/SearchSettings.jsx:316
#: src/admin/src/settings/pages/SearchSettings.jsx:500
msgid "If you have multiple search elements with different CSS selectors, separate them by a comma (,) such as: .search-form, .custom-search-form"
msgstr "Wenn du mehrere Suchelemente mit unterschiedlichen CSS-Selektoren hast, trenne sie durch ein Komma (,), zum Beispiel: .search-form, .custom-search-form"

#: src/admin/src/settings/pages/SearchSettings.jsx:320
msgid "Threshold"
msgstr "Schwellwert"

#: src/admin/src/settings/pages/SearchSettings.jsx:327
msgid " A threshold of 0.0 requires a perfect match, a threshold of 1.0 would match anything."
msgstr " Ein Schwellenwert von 0,0 erfordert eine perfekte Übereinstimmung, ein Schwellenwert von 1,0 würde auf alles passen."

#: src/admin/src/settings/pages/SearchSettings.jsx:337
msgid "Use Extended Search"
msgstr "Erweiterte Suche verwenden"

#: src/admin/src/settings/pages/SearchSettings.jsx:339
msgid "Enable Fuse.js extended search operators such as exact match, prefix, suffix, and inverse match."
msgstr "Erweiterte Suchoperatoren von Fuse.js wie exakte Übereinstimmung, Präfix, Suffix und umgekehrte Übereinstimmung aktivieren."

#: src/admin/src/settings/pages/SearchSettings.jsx:347
msgid "Ignore Location"
msgstr "Position ignorieren"

#: src/admin/src/settings/pages/SearchSettings.jsx:349
msgid "When enabled, the search will look for a match anywhere in the string, regardless of position. By default, Fuse.js favors matches near the beginning of a string."
msgstr "Wenn aktiviert, sucht die Suche unabhängig von der Position überall in der Zeichenfolge nach Übereinstimmungen. Standardmäßig bevorzugt Fuse.js Übereinstimmungen am Anfang einer Zeichenfolge."

#: src/admin/src/settings/pages/SearchSettings.jsx:357
msgid "Weight"
msgstr "Gewichtung"

#: src/admin/src/settings/pages/SearchSettings.jsx:358
msgid "Weighted search allows you to prioritize certain fields in your search results. A higher weight means results matching that field will appear higher in the results list. Default weight is 1."
msgstr "Mit der gewichteten Suche kannst du bestimmte Felder in den Suchergebnissen priorisieren. Bei einer höheren Gewichtung erscheinen Ergebnisse, die mit diesem Feld übereinstimmen, weiter oben. Die Standardgewichtung ist 1."

#: src/admin/src/settings/pages/SearchSettings.jsx:363
msgid "Title Weight"
msgstr "Gewichtung des Titels"

#: src/admin/src/settings/pages/SearchSettings.jsx:380
msgid "Content Weight"
msgstr "Gewichtung des Inhalts"

#: src/admin/src/settings/pages/SearchSettings.jsx:397
msgid "Excerpt Weight"
msgstr "Gewichtung des Textauszugs"

#: src/admin/src/settings/pages/SearchSettings.jsx:425
msgid "Algolia API"
